diff --git a/shim/shim.c b/shim/shim.c
index 1a1be66..c370175 100644
--- a/shim/shim.c
+++ b/shim/shim.c
@@ -521,6 +521,29 @@ static void __attribute__((noreturn)) bluejay_probe(uintptr_t dtb)
 {
 	stage = "bluejay probe";
 	struct wdt_state wdt_cl0 = {0}, wdt_cl1 = {0};
+#ifdef INVENTORY
+	/* Oriole first boot: use only the shim's RAM log and the existing,
+	 * live-FDT-validated USB pool. No framebuffer, pstore, UFS, secondary
+	 * CPUs, display trigger, touch, PMIC, DVFS, GPU or WLAN experiments.
+	 * WDT bases are verified in the current fetched vendor_boot DTB;
+	 * the existing reset chain is used after the bounded USB window. */
+	con_set_video(0, 0, 0, 0);
+	disable_bluejay_watchdog(WDT_CL0_BASE, &wdt_cl0);
+	disable_bluejay_watchdog(WDT_CL1_BASE, &wdt_cl1);
+	con_str("INVENTORY", "oriole: headless, no storage access");
+	con_hex("ENTRY EL", probe_entry_el);
+	con_hex("LIVE FDT", dtb);
+	report_bluejay_watchdog("WDT CL0", &wdt_cl0);
+	report_bluejay_watchdog("WDT CL1", &wdt_cl1);
+	report_cpu(0);
+	fdt_probe_report(dtb);
+#ifdef USB_GADGET
+	usb_gadget_start(dtb);
+	con_str("INVENTORY", "report complete");
+	usb_gadget_finish();
+#endif
+	bluejay_reset_chain();
+#endif
 	disable_bluejay_watchdog(WDT_CL0_BASE, &wdt_cl0);
 	disable_bluejay_watchdog(WDT_CL1_BASE, &wdt_cl1);
 
diff --git a/tools/test_oriole_inventory.py b/tools/test_oriole_inventory.py
new file mode 100644
index 0000000..b6726a7
--- /dev/null
+++ b/tools/test_oriole_inventory.py
@@ -0,0 +1,42 @@
+"""Fail-closed first-boot gates must run before any compilation or device action."""
+import os
+from pathlib import Path
+import subprocess
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class InventoryGateTests(unittest.TestCase):
+    def reject(self, args, message, **extra_env):
+        env = dict(os.environ, CROSS_CC='/nonexistent-inventory-compiler')
+        env.pop('USB_DMA_HI_BASE', None)
+        env.pop('USB_WINDOW', None)
+        env.update(extra_env)
+        p = subprocess.run(['bash', 'shim/build.sh', '--board', 'oriole'] + args,
+                           cwd=ROOT, env=env, capture_output=True, text=True, timeout=10)
+        self.assertEqual(p.returncode, 2, p.stderr)
+        self.assertIn(message, p.stderr)
+        self.assertNotIn('nonexistent-inventory-compiler', p.stderr)
+
+    def test_oriole_normal_boot_closed(self):
+        self.reject([], 'oriole is inventory-only')
+
+    def test_peripheral_and_payload_paths_closed(self):
+        for args in [['--boot-xnu'], ['--udump', '1'], ['--touch-probe=rails'],
+                     ['--gpu-job'], ['--wlan-link=27'], ['--dvfs', '100,100,100'],
+                     ['--pstore-fast'], ['--qrlog'], ['payload.bin']]:
+            with self.subTest(args=args):
+                self.reject(['--inventory'] + args, '--inventory cannot run')
+
+    def test_fixed_dma_override_closed(self):
+        self.reject(['--inventory'], 'no USB_DMA_HI_BASE', USB_DMA_HI_BASE='0x880200000ULL')
+
+    def test_window_bounded(self):
+        for value in ['0', '61', '-1', 'garbage']:
+            with self.subTest(value=value):
+                self.reject(['--inventory'], 'USB_WINDOW must be 1..60', USB_WINDOW=value)
+
+
+if __name__ == '__main__':
+    unittest.main()
