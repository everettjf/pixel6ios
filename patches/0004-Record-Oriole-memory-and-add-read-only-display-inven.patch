--- /dev/null
+++ b/soc/google/gs101/docs/display-inventory.md
@@ -0,0 +1,20 @@
+# Read-only display inventory
+
+READ FROM SOURCE: Google display module commit
+[661047c0c1c4939aa81fcc822bb21dc5a484f913](https://android.googlesource.com/kernel/google-modules/display/+/661047c0c1c4939aa81fcc822bb21dc5a484f913/samsung/cal_9845/regs-dpp.h).
+RDMA L0..L5 base is 0x1c0b0000, spacing 0x1000. The current fetched
+vendor_boot_a DTB agrees (drmdpp0..5 DMA reg). Shadow offset is 0x400.
+Read offsets: ENABLE 0x00, IN_CTRL_0 0x08, SRC_SIZE 0x10,
+SRC_OFFSET 0x14, IMG_SIZE 0x18, BASEADDR_Y8 0x40, SRC_STRIDE_0 0x50,
+SRC_STRIDE_1 0x54. These are configuration registers, not interrupt-clear
+or FIFO registers. soc.json is the source of all numeric read addresses.
+
+UNVERIFIED on Oriole until a capture: configuration values and whether
+all RDMA blocks remain readable after ABL. A synchronous fault skips the
+rest of that channel. There are six channels, two banks and eight offsets;
+no waits, no writes, no clock/trigger/DSIM actions. Only opt-in
+--inventory-display links this reader. Ordinary inventory is unchanged.
+
+The extra generated macros intentionally affect GS101 headers; existing
+non-inventory image code has no references to them. This does not enable
+a display or grant permission to write the candidate framebuffer.
diff --git a/soc/google/gs101/shim/displayinventory.c b/soc/google/gs101/shim/displayinventory.c
new file mode 100644
index 0000000..2e189d5
--- /dev/null
+++ b/soc/google/gs101/shim/displayinventory.c
@@ -0,0 +1,33 @@
+/* Read-only GS101 RDMA inventory. No framebuffer or MMIO stores.
+ * Register source: Google display commit 661047c0c1c4939aa81fcc822bb21dc5a484f913,
+ * samsung/cal_9845/regs-dpp.h: RDMA(L0~L5), DMA_SHD_OFFSET, RDMA_ENABLE,
+ * RDMA_IN_CTRL_0, RDMA_SRC_SIZE/OFFSET, RDMA_IMG_SIZE, RDMA_BASEADDR_Y8,
+ * RDMA_SRC_STRIDE_0/1. Base/stride also match current vendor_boot drmdpp0..5.
+ * See soc/google/gs101/docs/display-inventory.md. A fault stops that channel.
+ */
+#include <stdint.h>
+#include "console.h"
+int try_read32(uintptr_t address, uint32_t *value);
+
+void gs101_display_inventory(void)
+{
+    const unsigned offsets[] = { DISPLAY_INV_REG_OFFSETS };
+    con_str("DISPLAY inventory", "read only; no clocks or triggers changed");
+    for (unsigned ch = 0; ch < DISPLAY_INV_RDMA_COUNT; ch++) {
+        uintptr_t base = DISPLAY_INV_RDMA_BASE + ch * DISPLAY_INV_RDMA_STRIDE;
+        con_hex("RDMA channel", ch);
+        int fault = 0;
+        for (unsigned shadow = 0; shadow < 2 && !fault; shadow++) {
+            for (unsigned n = 0; n < sizeof(offsets) / sizeof(offsets[0]); n++) {
+                uintptr_t address = base + shadow * DISPLAY_INV_SHADOW_OFFSET + offsets[n];
+                uint32_t value;
+                if (!try_read32(address, &value)) {
+                    con_hex("RDMA read fault", address);
+                    fault = 1;
+                    break;
+                }
+                con_hex2("RDMA", "address=", address, "value=", value);
+            }
+        }
+    }
+}
