 	echo "oriole is inventory-only until its live memory map is measured" >&2; exit 2
 fi
+if [ "$inventory_ufs" = 1 ]; then
+    [ "$board:$inventory_display" = oriole:0 ] && [ -z "${UFS_DMA_HI_BASE:-}${UFS_ATTEMPTS:-}${XNU_UFS:-}${REBOOT_BL:-}" ] || {
