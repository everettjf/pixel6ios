+/* The stock HFSX attributes fork starts at allocation block 3458. Its
+ * previously-unused 8192-byte node 3 occupies device blocks 3464-3465.
+ * Trace only the first few accesses to this measured range so that a fresh
+ * boot reveals whether XNU writes it and whether the COW read sees the data. */
+static void
+oriole_cow_trace_node(bool rd, uint64_t lba, uint32_t blocks,
+    const uint8_t *bounce, int error)
+{
+	uint32_t *seen = rd ? &oriole_cow_trace_reads : &oriole_cow_trace_writes;
+	for (uint32_t i = 0; i < blocks; i++) {
+		uint64_t block = lba + i;
+		if (block != 3464 && block != 3465) continue;
+		if ((*seen)++ >= 32) continue;
+		const uint8_t *p = bounce + i * UFS_BLOCK;
+		printf("ORIOLE COW TRACE %c lba=%llu hit=%u err=%d pages=%u head=%02x%02x%02x%02x%02x%02x%02x%02x\n",
+		    rd ? 'R' : 'W', block, oriole_cow_find(block) != NULL,
+		    error, oriole_cow_pages, p[0], p[1], p[2], p[3],
+		    p[4], p[5], p[6], p[7]);
+	}
 }
 
