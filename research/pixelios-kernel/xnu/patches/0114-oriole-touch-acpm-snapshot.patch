+static void tg_oriole_acpm_snapshot(void);
 
 static bool
 tg_identify(void)
@@ -967,8 +969,64 @@
 		tg_spi_diag("ID mismatch");
 		tg_pin_report("reset after ID", &tg.reset);
 		tg_pin_report("mux after ID", &tg.mux);
+		tg_oriole_acpm_snapshot();
 	}
 	return match != 0;
