+static void
+sweet_hid_try_rematch(const char *cause)
+{
+	static unsigned rematch_requested;
+	SweetHIDTouch *touch = __atomic_load_n(&gSweetTouch, __ATOMIC_ACQUIRE);
+	if (!sweet_hid_is_oriole()) {
+		return;
+	}
+	int enabled = 0;
+	IOService *resources = IOService::getResourceService();
+	bool opt_in = PE_parse_boot_argn("sweethidrematch", &enabled, sizeof(enabled)) && enabled;
+	IOLog("SWEET HID DIAG: %s stage=%u buttons=%u touch=%u resources=%u rematch=%u\n",
+	    cause, __atomic_load_n(&gSweetTouchStartStage, __ATOMIC_ACQUIRE),
+	    __atomic_load_n(&gSweetButtons, __ATOMIC_ACQUIRE) != NULL,
+	    touch != NULL, resources != NULL, opt_in);
+	if (!touch && opt_in && resources) {
+		unsigned expected = 0;
+		if (__atomic_compare_exchange_n(&rematch_requested, &expected, 1u,
+		    false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+			resources->registerService(kIOServiceAsynchronous);
+			IOLog("SWEET HID DIAG: asynchronous IOResources rematch requested by %s\n", cause);
+		}
+	}
+}
+
+/* Request rematching at scan start, before polling input. */
+extern "C" void
+sweet_hid_probe(void)
+{
+	sweet_hid_try_rematch("scan");
+}
