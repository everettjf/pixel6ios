+/* Read-only, one-row-per-tick panel sample on a separate workloop. */
+void
+AppleCLCD::snapFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint32_t row, serial;
+	IOLockLock(fb->fLock);
+	if (fb->fPowerOff || sweet_qr_hold) {
+		fb->fSnapRow = 0;
+		IOLockUnlock(fb->fLock);
+		sender->setTimeoutUS(SWEET_FB_SNAP_INTERVAL_US);
+		return;
+	}
+	row = fb->fSnapRow;
+	serial = fb->fSnapSerial;
+	if (row == 0) {
+		serial = ++fb->fSnapSerial;
+	}
+	fb->fSnapRow = row + 1;
+	IOLockUnlock(fb->fLock);
+	if (row == 0) {
+		/* Each scan spans ~1.34 s and can mix successive presented frames. */
+		IOLog("SWEET FB SNAP %u BEGIN %u %u rolling=1\n", serial,
+		    SWEET_FB_SNAP_W, SWEET_FB_SNAP_H);
+	}
+	static const char digits[] = "0123456789abcdef";
+	char line[SWEET_FB_SNAP_W * 2 + 1];
+	uint32_t sy = ((uint64_t)(2 * row + 1) * fb->fHeight) / (2 * SWEET_FB_SNAP_H);
+	for (uint32_t x = 0; x < SWEET_FB_SNAP_W; x++) {
+		uint32_t sx = ((uint64_t)(2 * x + 1) * fb->fWidth) / (2 * SWEET_FB_SNAP_W);
+		volatile uint32_t *p = (volatile uint32_t *)(fb->fPixels +
+		    (uint64_t)sy * fb->fRowBytes + (uint64_t)sx * 4);
+		uint32_t pixel = *p; /* a8r8g8b8, documented boot framebuffer */
+		uint8_t rgb332 = (pixel & 0x00e00000) >> 16 |
+		    (pixel & 0x0000e000) >> 11 | (pixel & 0x000000c0) >> 6;
+		line[2 * x] = digits[rgb332 >> 4];
+		line[2 * x + 1] = digits[rgb332 & 15];
+	}
+	line[SWEET_FB_SNAP_W * 2] = '\0';
+	IOLog("SWEET FB SNAP %u R %u %s\n", serial, row, line);
+	if (row + 1 == SWEET_FB_SNAP_H) {
+		IOLog("SWEET FB SNAP %u END\n", serial);
+		fb->fSnapRow = 0;
+		sender->setTimeoutUS(SWEET_FB_SNAP_INTERVAL_US);
+	} else {
+		sender->setTimeoutUS(SWEET_FB_SNAP_ROW_US);
+	}
+}
