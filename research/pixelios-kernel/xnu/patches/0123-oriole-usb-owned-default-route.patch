 /*
+ * A device-owned default route can be replaced while its interface is up.
+ * Check identity and remove it under the same route-table lock so a later
+ * owner's route is never deleted by a device disconnect.
+ */
+int
+rtrequest_delete_if_same(struct sockaddr *dst, struct sockaddr *netmask,
+    struct sockaddr *expected_gateway, unsigned int expected_ifindex,
+    struct rtentry *expected)
+{
+	struct radix_node_head *rnh;
+	struct radix_node *rn;
+	struct rtentry *rt;
+	boolean_t same;
+	int error;
+
+	if (dst == NULL || netmask == NULL || expected_gateway == NULL ||
+	    expected == NULL || expected_ifindex == 0 ||
+	    dst->sa_family != AF_INET || netmask->sa_family != AF_INET ||
+	    expected_gateway->sa_family != AF_INET) {
+		return EINVAL;
+	}
+	LCK_MTX_ASSERT(rnh_lock, LCK_MTX_ASSERT_NOTOWNED);
+	lck_mtx_lock(rnh_lock);
+	rnh = rt_tables[AF_INET];
+	rn = rnh == NULL ? NULL : rnh->rnh_lookup(dst, netmask, rnh);
+	if (rn != (struct radix_node *)expected) {
+		error = ESRCH;
+	} else {
+		rt = (struct rtentry *)rn;
+		RT_LOCK(rt);
+		same = (rt->rt_flags & (RTF_UP | RTF_STATIC | RTF_GATEWAY)) ==
+		    (RTF_UP | RTF_STATIC | RTF_GATEWAY) && rt->rt_ifp != NULL &&
+		    rt->rt_ifp->if_index == expected_ifindex &&
+		    rt->rt_gateway != NULL &&
+		    rt->rt_gateway->sa_family == AF_INET &&
+		    rt->rt_gateway->sa_len >= sizeof(struct sockaddr_in) &&
+		    ((struct sockaddr_in *)rt->rt_gateway)->sin_addr.s_addr ==
+		    ((struct sockaddr_in *)expected_gateway)->sin_addr.s_addr;
+		RT_UNLOCK(rt);
+		error = same ? rtrequest_scoped_locked(RTM_DELETE, dst, NULL,
+		    netmask, 0, NULL, IFSCOPE_NONE) : ESRCH;
+	}
+	lck_mtx_unlock(rnh_lock);
+	return error;
+}
+
+/* Keep the route-table lock from insertion through interface validation.
+ * A gateway address alone could otherwise select an overlapping interface. */
+int
+rtrequest_add_gateway_on_ifindex(struct sockaddr *dst, struct sockaddr *gateway,
+    struct sockaddr *netmask, int flags, unsigned int expected_ifindex,
+    struct rtentry **ret_nrt)
+{
+	struct rtentry *rt = NULL;
+	boolean_t selected;
+	int error, undo_error;
+
+	if (dst == NULL || gateway == NULL || netmask == NULL ||
+	    expected_ifindex == 0 || ret_nrt == NULL ||
+	    dst->sa_family != AF_INET || gateway->sa_family != AF_INET ||
+	    netmask->sa_family != AF_INET) {
+		return EINVAL;
+	}
+	*ret_nrt = NULL;
+	LCK_MTX_ASSERT(rnh_lock, LCK_MTX_ASSERT_NOTOWNED);
+	lck_mtx_lock(rnh_lock);
+	error = rtrequest_scoped_locked(RTM_ADD, dst, gateway, netmask, flags,
+	    &rt, IFSCOPE_NONE);
+	if (error == 0) {
+		RT_LOCK(rt);
+		selected = rt->rt_ifp != NULL &&
+		    rt->rt_ifp->if_index == expected_ifindex;
+		RT_UNLOCK(rt);
+		if (!selected) {
+			undo_error = rtrequest_scoped_locked(RTM_DELETE, dst, NULL,
+			    netmask, 0, NULL, IFSCOPE_NONE);
+			if (undo_error != 0) {
+				printf("SWEET NET: wrong-interface route undo failed %d\n",
+				    undo_error);
+				*ret_nrt = rt; /* caller retains reference until link-down */
+				rt = NULL;
+			}
+			error = ENXIO;
+		}
+	}
+	lck_mtx_unlock(rnh_lock);
+	if (error == 0) {
+		*ret_nrt = rt;
+	} else if (rt != NULL) {
+		rtfree(rt);
+	}
+	return error;
+}
