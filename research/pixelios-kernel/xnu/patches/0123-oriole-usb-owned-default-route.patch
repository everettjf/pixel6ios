+/* XNU-8796 bsd/kern/netboot.c:route_cmd/default_route_add supplies the
+ * route flags and rtrequest_scoped form. The exact /24 peer is the existing
+ * ECM host address. Route ownership is kept by the returned reference. */
+static void
+ud_netroute_addrs(struct sockaddr_in *dst, struct sockaddr_in *gw,
+    struct sockaddr_in *mask)
+{
+	bzero(dst, sizeof(*dst));
+	bzero(gw, sizeof(*gw));
+	bzero(mask, sizeof(*mask));
+	dst->sin_len = gw->sin_len = mask->sin_len = sizeof(*dst);
+	dst->sin_family = gw->sin_family = mask->sin_family = AF_INET;
+	gw->sin_addr.s_addr = htonl(0xc0a80701); /* 192.168.7.1 */
+}
+
+/* Called by the polled USB thread, never from an interrupt handler. */
+static void
+ud_netroute_link(bool up)
+{
+	struct sockaddr_in dst, gw, mask;
+	int error;
+
+	if (!ud.netroute_enabled) {
+		return;
+	}
+	ud_netroute_addrs(&dst, &gw, &mask);
+	if (up) {
+		if (!ud.netroute_link_up) {
+			ud.netroute_link_up = true;
+			ud_link_event(true);
+		}
+		if (!ud.netroute_ip_ready || ud.netroute_owned != NULL) {
+			return;
+		}
+		error = rtrequest_add_gateway_on_ifindex((struct sockaddr *)&dst,
+		    (struct sockaddr *)&gw, (struct sockaddr *)&mask,
+		    RTF_UP | RTF_STATIC | RTF_GATEWAY, ifnet_index(ud.ifp),
+		    &ud.netroute_owned);
+		printf("SWEET NET: ue0 default route add %d owned=%d\n", error,
+		    ud.netroute_owned != NULL);
+		return;
+	}
+	if (ud.netroute_owned != NULL) {
+		error = rtrequest_delete_if_same((struct sockaddr *)&dst,
+		    (struct sockaddr *)&mask, (struct sockaddr *)&gw,
+		    ifnet_index(ud.ifp), ud.netroute_owned);
+		printf("SWEET NET: ue0 owned default route remove %d\n", error);
+		if (error == 0 || error == ESRCH) {
+			rtfree(ud.netroute_owned);
+			ud.netroute_owned = NULL;
+		}
+	}
+	if (ud.netroute_link_up) {
+		ud.netroute_link_up = false;
+		ud_link_event(false);
+	}
+}
