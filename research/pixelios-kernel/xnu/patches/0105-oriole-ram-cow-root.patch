+/* Only the exact Oriole COW profile uses this volatile block overlay.  No
+ * physical UFS write is reachable in that profile: ufs_scsi still rejects
+ * every data-out command, and ufs_write_blocks still rejects Oriole. */
+#define ORIOLE_COW_BUCKETS 16384u
+#define ORIOLE_COW_MAX_PAGES 65536u
+struct oriole_cow_page {
+	struct oriole_cow_page *next;
+	uint64_t lba;
+	uint8_t *data;
+};
+static struct oriole_cow_page **oriole_cow_buckets;
+static uint32_t oriole_cow_pages;
+
+static uint32_t
+oriole_cow_bucket(uint64_t lba)
+{
+	return (uint32_t)((lba ^ (lba >> 14) ^ (lba >> 28)) & (ORIOLE_COW_BUCKETS - 1));
+}
+
+static struct oriole_cow_page *
+oriole_cow_find(uint64_t lba)
+{
+	for (struct oriole_cow_page *p = oriole_cow_buckets[oriole_cow_bucket(lba)];
+	    p; p = p->next) if (p->lba == lba) return p;
+	return NULL;
+}
+
+/* Caller holds sweet_ufs_lock; the bounce buffer contains physical blocks. */
+static void
+oriole_cow_overlay(uint64_t lba, uint32_t blocks, uint8_t *bounce)
+{
+	for (uint32_t i = 0; i < blocks; i++) {
+		struct oriole_cow_page *p = oriole_cow_find(lba + i);
+		if (p) memcpy(bounce + i * UFS_BLOCK, p->data, UFS_BLOCK);
+	}
+}
+
+/* All allocations precede mutations, so ENOMEM/ENOSPC leaves this bounce
+ * chunk unchanged. A larger strategy request can complete earlier chunks.
+ * The caller has already checked the GPT range. */
+static int
+oriole_cow_store(uint64_t lba, uint32_t blocks, const uint8_t *bounce)
+{
+	struct oriole_cow_page *pending = NULL;
+	uint32_t missing = 0;
+	for (uint32_t i = 0; i < blocks; i++) missing += oriole_cow_find(lba + i) == NULL;
+	if (missing > ORIOLE_COW_MAX_PAGES - oriole_cow_pages) return ENOSPC;
+	for (uint32_t i = 0; i < missing; i++) {
+		struct oriole_cow_page *p = kalloc_type(struct oriole_cow_page, Z_NOWAIT | Z_ZERO);
+		if (!p) goto nomem;
+		p->data = kalloc_data(UFS_BLOCK, Z_NOWAIT);
+		if (!p->data) { kfree_type(struct oriole_cow_page, p); goto nomem; }
+		p->next = pending;
+		pending = p;
+	}
+	for (uint32_t i = 0; i < blocks; i++) {
+		uint64_t block = lba + i;
+		struct oriole_cow_page *p = oriole_cow_find(block);
+		if (!p) {
+			p = pending;
+			pending = pending->next;
+			p->lba = block;
+			uint32_t bucket = oriole_cow_bucket(block);
+			p->next = oriole_cow_buckets[bucket];
+			oriole_cow_buckets[bucket] = p;
+			oriole_cow_pages++;
+		}
+		memcpy(p->data, bounce + i * UFS_BLOCK, UFS_BLOCK);
+	}
+	return 0;
+nomem:
+	while (pending) {
+		struct oriole_cow_page *next = pending->next;
+		kfree_data(pending->data, UFS_BLOCK);
+		kfree_type(struct oriole_cow_page, pending);
+		pending = next;
+	}
+	return ENOMEM;
+}
