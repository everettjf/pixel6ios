+	bool opt_in = PE_parse_boot_argn("sweethidrematch", &enabled, sizeof(enabled)) && enabled;
+	if (resources && gIOCatalogue && strcmp(cause, "scan") == 0) {
+		SInt32 generation = -1;
+		OSPtr<OSOrderedSet> candidates = gIOCatalogue->findDrivers(resources, &generation);
+		unsigned touch_count = 0, button_count = 0;
+		if (candidates) {
+			for (unsigned i = 0; i < candidates->getCount(); i++) {
+				OSDictionary *entry = OSDynamicCast(OSDictionary, candidates->getObject(i));
+				OSString *name = entry ? OSDynamicCast(OSString, entry->getObject("IOClass")) : NULL;
+				if (name && name->isEqualTo("SweetHIDTouch")) touch_count++;
+				if (name && name->isEqualTo("SweetHIDButtons")) button_count++;
+			}
+		}
+		const OSSymbol *touch_name = OSSymbol::withCString("SweetHIDTouch");
+		const OSSymbol *button_name = OSSymbol::withCString("SweetHIDButtons");
+		bool touch_meta = touch_name && OSMetaClass::getMetaClassWithName(touch_name);
+		bool button_meta = button_name && OSMetaClass::getMetaClassWithName(button_name);
+		IOLog("SWEET HID DIAG: catalog generation=%d candidates=%u touch=%u buttons=%u meta-touch=%u meta-buttons=%u\n",
+		    generation, candidates ? candidates->getCount() : 0,
+		    touch_count, button_count, touch_meta, button_meta);
+		OSSafeReleaseNULL(touch_name);
+		OSSafeReleaseNULL(button_name);
+	}
+	IOLog("SWEET HID DIAG: %s stage=%u buttons=%u touch=%u resources=%u rematch=%u\n",
+	    cause, __atomic_load_n(&gSweetTouchStartStage, __ATOMIC_ACQUIRE),
+	    __atomic_load_n(&gSweetButtons, __ATOMIC_ACQUIRE) != NULL,
+	    touch != NULL, resources != NULL, opt_in);
+	if (!touch && opt_in && resources) {
+		unsigned expected = 0;
+		if (__atomic_compare_exchange_n(&rematch_requested, &expected, 1u,
+		    false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+			resources->registerService(kIOServiceAsynchronous);
+			IOLog("SWEET HID DIAG: asynchronous IOResources rematch requested by %s\n", cause);
+		}
+	}
+}
