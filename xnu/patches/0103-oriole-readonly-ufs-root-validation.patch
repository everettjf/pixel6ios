+/* Oriole: same CRC/range/overlap validator as the hardware-run inventory.
+ * Bounce buffer is 1MiB; at most16KiB of entries, no kernel-stack table. */
+static int
+ufs_find_oriole_userdata(const char *want)
+{
+    const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+    const uint8_t capacity[10] = { 0x25 }; /* SCSI READ CAPACITY(10) */
+    if (strcmp(want, "userdata") != 0) return EINVAL;
+    int error = ufs_scsi(capacity, sizeof(capacity), 8, false);
+    if (error) return error;
+    uint32_t last = oriole_ufs_be32(b), block = oriole_ufs_be32(b + 4);
+    printf("ORIOLE UFS: capacity last 0x%x block %u\n", last, block);
+    if (last != ORIOLE_CAPACITY_LAST || block != UFS_BLOCK) return ENXIO;
+    error = ufs_read_blocks(1, 1);
+    if (error) return error;
+    struct ufsi_gpt g;
+    if (!ufsi_gpt_header(b, last, &g)) return ENXIO;
+    error = ufs_read_blocks(g.table, g.blocks);
+    if (error) return error;
+    uint64_t first = 0, end = 0;
+    if (!oriole_ufs_userdata(b, &g, &first, &end)) return ENXIO;
+    su.first_block = first;
+    su.nblocks = end - first + 1;
+    printf("ORIOLE UFS: unique userdata CRC/ranges PASS 0x%llx..0x%llx, read-only\n", first, end);
+    return 0;
+}
