+/* Failure cannot leave a live owned DMA list before root selection retries.
+ * Same GS101 slot-mask clear +100ms bounded stop as shim inventory. */
+static void
+ufs_oriole_stop(void)
+{
+    if (!su.oriole || !su.own_list) return;
+    uint32_t dbr = ufs_rd(REG_UTRLDBR);
+    if (dbr & ~2u) panic("ORIOLE UFS: foreign doorbell on failure");
+    if (dbr) ufs_wr(REG_UTRLCLR, 2);
+    for (unsigned i = 0; i < 10000 && ufs_rd(REG_UTRLDBR); i++) delay(10);
+    if (ufs_rd(REG_UTRLDBR)) panic("ORIOLE UFS: DMA clear failed");
+    ufs_wr(REG_UTRLRSR, 0);
+    for (unsigned i = 0; i < 10000 && (ufs_rd(REG_UTRLRSR) & 1); i++) delay(10);
+    if ((ufs_rd(REG_UTRLRSR) & 1) || ufs_rd(REG_UTRLDBR)) panic("ORIOLE UFS: DMA stop failed");
+    su.own_list = false;
+}
